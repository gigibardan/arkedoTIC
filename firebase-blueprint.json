{
  "entities": {
    "RezultatTic": {
      "title": "RezultatTic",
      "description": "Rezultatele testelor trimise de elevi",
      "type": "object",
      "properties": {
        "studentName": { "type": "string" },
        "grade": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "percentage": { "type": "number" },
        "date": { "type": "string" }
      }
    },
    "Elev": {
      "title": "Elev",
      "description": "Profilul elevului cu scoruri arcade, progres lectii, carnet digital si diplome",
      "type": "object",
      "properties": {
        "studentName": { "type": "string" },
        "avatar": { "type": "string" },
        "classGrade": { "type": "string" },
        "schoolId": { "type": "string" },
        "totalScore": { "type": "number" },
        "totalXP": { "type": "number" },
        "byteCoins": { "type": "number" },
        "arcadeScores": { "type": "object" },
        "lessonsProgress": { "type": "object" },
        "duelStats": { "type": "object" },
        "completedLessons": { "type": "array" },
        "diplomas": { "type": "object" },
        "dailyStreak": { "type": "object" },
        "dailyQuests": { "type": "object" },
        "unlockedBadgeIds": { "type": "array" },
        "sandboxProgress": { "type": "object" },
        "quickEvalHistory": { "type": "array" },
        "carnetUpdatedAt": { "type": "string" }
      }
    },
    "DuelRoom": {
      "title": "DuelRoom",
      "description": "Camere de duel multiplayer 1v1 intre elevi in timp real",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string" },
        "mode": { "type": "string" },
        "status": { "type": "string" },
        "host": { "type": "object" },
        "guest": { "type": "object" },
        "winner": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["roomCode", "mode", "status", "host"]
    },
    "SetariJocuri": {
      "title": "SetariJocuri",
      "description": "Starea de activare/blocare a jocurilor arcade de catre profesor",
      "type": "object",
      "properties": {
        "allGamesOpen": { "type": "boolean" },
        "gameStatus": { "type": "object" },
        "customMessage": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      }
    },
    "SolicitareDeschidereJoc": {
      "title": "SolicitareDeschidereJoc",
      "description": "Cereri trimise de elevi profesorului pentru deblocarea unui joc",
      "type": "object",
      "properties": {
        "gameId": { "type": "string" },
        "gameTitle": { "type": "string" },
        "studentName": { "type": "string" },
        "studentAvatar": { "type": "string" },
        "timestamp": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["gameId", "studentName", "timestamp"]
    },
    "RecorduriJocuri": {
      "title": "RecorduriJocuri",
      "description": "Tabel dedicat de recorduri all-time optimizat pentru 1 singura citire rapida",
      "type": "object",
      "properties": {
        "records": { "type": "object" },
        "lastUpdated": { "type": "string" }
      }
    },
    "SuperAdmin": {
      "title": "SuperAdmin",
      "description": "Utilizator cu privilegii globale de Superadmin",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastLogin": { "type": "number" }
      },
      "required": ["email", "role"]
    },
    "Profesor": {
      "title": "Profesor",
      "description": "Conturi de profesori asociate cu o școală",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "schoolId": { "type": "string" },
        "role": { "type": "string" },
        "approved": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "name", "role"]
    },
    "Scoala": {
      "title": "Scoala",
      "description": "Instituții de învățământ înregistrate în sistemul multi-școală",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "city": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "code"]
    },
    "ClasaGrupa": {
      "title": "ClasaGrupa",
      "description": "Clase și grupe de elevi create de profesor cu cod unic de alăturare",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 100 },
        "gradeNum": { "type": "number" },
        "schoolId": { "type": "string", "maxLength": 80 },
        "teacherName": { "type": "string", "maxLength": 100 },
        "academicYear": { "type": "string", "maxLength": 24 },
        "memberUsernames": { "type": "array" },
        "memberIds": { "type": "array" },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["code", "name", "gradeNum", "schoolId", "teacherName"]
    },
    "TemaAssignment": {
      "title": "TemaAssignment",
      "description": "Teme și evaluări cu termen limită atribuite unei clase",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 140 },
        "description": { "type": "string", "maxLength": 600 },
        "classId": { "type": "string", "maxLength": 80 },
        "className": { "type": "string", "maxLength": 100 },
        "schoolId": { "type": "string", "maxLength": 80 },
        "teacherName": { "type": "string", "maxLength": 100 },
        "dueDate": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "tasks": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "classId", "dueDate", "status", "tasks"]
    },
    "QuizLiveSession": {
      "title": "QuizLiveSession",
      "description": "Sesiune de quiz live în clasă sincronizată în timp real",
      "type": "object",
      "properties": {
        "pin": { "type": "string", "maxLength": 12 },
        "title": { "type": "string", "maxLength": 140 },
        "classId": { "type": "string", "maxLength": 80 },
        "className": { "type": "string", "maxLength": 100 },
        "schoolId": { "type": "string", "maxLength": 80 },
        "teacherName": { "type": "string", "maxLength": 100 },
        "phase": { "type": "string", "enum": ["lobby", "question", "reveal", "leaderboard", "finished"] },
        "currentQuestionIndex": { "type": "number" },
        "questionStartedAt": { "type": "number" },
        "secondsPerQuestion": { "type": "number" },
        "questions": { "type": "array" },
        "gradesLogged": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["pin", "title", "phase", "currentQuestionIndex", "secondsPerQuestion", "questions"]
    },
    "QuizLiveParticipant": {
      "title": "QuizLiveParticipant",
      "description": "Participant elev conectat la o sesiune Quiz Live",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "avatar": { "type": "string", "maxLength": 16 },
        "score": { "type": "number" },
        "correctCount": { "type": "number" },
        "streak": { "type": "number" },
        "answers": { "type": "object" },
        "joinedAt": { "type": "number" },
        "lastSeenAt": { "type": "number" }
      },
      "required": ["name", "score", "correctCount"]
    }
  },
  "firestore": {
    "/rezultate_tic/{resultId}": {
      "schema": "RezultatTic",
      "description": "Rezultate teste elevi"
    },
    "/elevi/{studentId}": {
      "schema": "Elev",
      "description": "Profiluri elevi si clasamente"
    },
    "/duel_rooms/{roomId}": {
      "schema": "DuelRoom",
      "description": "Camere de duel multiplayer in timp real"
    },
    "/setari_jocuri/{settingId}": {
      "schema": "SetariJocuri",
      "description": "Configurare blocare/deblocare jocuri arcade"
    },
    "/solicitari_jocuri/{requestId}": {
      "schema": "SolicitareDeschidereJoc",
      "description": "Cereri de deschidere jocuri de la elevi"
    },
    "/recorduri_jocuri/{documentId}": {
      "schema": "RecorduriJocuri",
      "description": "Recorduri all-time globale salvate intr-un singur document"
    },
    "/superadmins/{uid}": {
      "schema": "SuperAdmin",
      "description": "Conturi de superadmin verificate prin Firebase Auth"
    },
    "/profesori/{uid}": {
      "schema": "Profesor",
      "description": "Conturi profesori asociate școlilor"
    },
    "/scoli/{schoolId}": {
      "schema": "Scoala",
      "description": "Școli înregistrate pe platformă"
    },
    "/clase_grupe/{classId}": {
      "schema": "ClasaGrupa",
      "description": "Clase și grupe de elevi cu cod de alăturare"
    },
    "/teme_assignments/{assignmentId}": {
      "schema": "TemaAssignment",
      "description": "Teme și evaluări atribuite claselor cu termen limită"
    },
    "/quiz_live_sessions/{sessionId}": {
      "schema": "QuizLiveSession",
      "description": "Sesiuni de Quiz Live sincronizate în timp real"
    },
    "/quiz_live_sessions/{sessionId}/participants/{playerId}": {
      "schema": "QuizLiveParticipant",
      "description": "Participanții și răspunsurile unei sesiuni Quiz Live"
    }
  }
}

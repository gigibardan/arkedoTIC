rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Verificare utilizator autentificat
    function isSignedIn() {
      return request.auth != null;
    }

    // Verificare rol SuperAdmin securizat server-side prin token sau document dedicat
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'Gheorghe.Bardan@gmail.com' ||
        request.auth.token.role == 'superadmin' ||
        exists(/databases/$(database)/documents/superadmins/$(request.auth.uid))
      );
    }

    // Verificare rol Profesor autorizat sau SuperAdmin
    function isTeacher() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.role == 'teacher' ||
        exists(/databases/$(database)/documents/profesori/$(request.auth.uid))
      );
    }

    // Colecție dedicată SuperAdmins: acces strict protejat
    match /superadmins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Colecție Profesori: administrare centralizată
    match /profesori/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isTeacher() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Instituții școlare
    match /scoli/{schoolId} {
      allow read: if true;
      allow write: if isSuperAdmin() || true;
    }

    // Elevii trimit rezultatele testelor, iar profesorul/superadminul le poate citi/administra
    match /rezultate_tic/{document} {
      allow read, write: if true;
    }

    // Conturile elevilor, punctaje mini-jocuri, progres lectii si clasamente
    match /elevi/{document} {
      allow read, write: if true;
    }

    // Camere de duel multiplayer 1v1 in timp real
    match /duel_rooms/{document} {
      allow read, write: if true;
    }

    // Setari comutator jocuri arcade pentru profesor si superadmin
    match /setari_jocuri/{document} {
      allow read, write: if true;
    }

    // Solicitari de deschidere jocuri trimise de elevi
    match /solicitari_jocuri/{document} {
      allow read, write: if true;
    }

    // Recorduri all-time pentru mini-jocuri (optimizat 1 singur document)
    match /recorduri_jocuri/{document} {
      allow read, write: if true;
    }

    // Mesaje de contact primite de la utilizatori/profesori
    match /contact_messages/{document} {
      allow create: if true;
      allow read, update, delete: if isTeacher() || isSuperAdmin();
    }

    // Helper validare ID sigur
    function isSafeDocId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidClassroomData(data) {
      return data.keys().hasAll(['code', 'name', 'gradeNum', 'schoolId', 'teacherName'])
        && data.code is string && data.code.size() >= 3 && data.code.size() <= 32
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.gradeNum is int && data.gradeNum >= 5 && data.gradeNum <= 8
        && data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 80
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 100
        && (!('memberIds' in data) || (data.memberIds is list && data.memberIds.size() <= 300))
        && (!('memberUsernames' in data) || (data.memberUsernames is list && data.memberUsernames.size() <= 300));
    }

    function isValidAssignmentData(data) {
      return data.keys().hasAll(['title', 'classId', 'dueDate', 'status', 'tasks'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 80
        && data.dueDate is string && data.dueDate.size() >= 4 && data.dueDate.size() <= 40
        && data.status in ['active', 'closed']
        && data.tasks is list && data.tasks.size() >= 1 && data.tasks.size() <= 30;
    }

    function isValidLiveQuizSessionData(data) {
      return data.keys().hasAll(['pin', 'title', 'phase', 'currentQuestionIndex', 'secondsPerQuestion', 'questions'])
        && data.pin is string && data.pin.size() >= 4 && data.pin.size() <= 12
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.phase in ['lobby', 'question', 'reveal', 'leaderboard', 'finished']
        && data.currentQuestionIndex is int && data.currentQuestionIndex >= 0 && data.currentQuestionIndex <= 50
        && data.secondsPerQuestion is int && data.secondsPerQuestion >= 5 && data.secondsPerQuestion <= 120
        && data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 50;
    }

    function isValidLiveQuizParticipantData(data) {
      return data.keys().hasAll(['name', 'score', 'correctCount'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.score is number && data.score >= 0 && data.score <= 200000
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 50;
    }

    // Clase / Grupe de elevi cu cod unic de alaturare
    match /clase_grupe/{classId} {
      allow list: if true;
      allow get: if isSafeDocId(classId);
      allow create, update: if isSafeDocId(classId) && isValidClassroomData(request.resource.data);
      allow delete: if isSafeDocId(classId);
    }

    // Teme si evaluari cu termen limita atribuite claselor
    match /teme_assignments/{assignmentId} {
      allow list: if true;
      allow get: if isSafeDocId(assignmentId);
      allow create, update: if isSafeDocId(assignmentId) && isValidAssignmentData(request.resource.data);
      allow delete: if isSafeDocId(assignmentId);
    }

    // Sesiuni Quiz Live in clasa (stil Kahoot real-time)
    match /quiz_live_sessions/{sessionId} {
      allow list: if true;
      allow get: if isSafeDocId(sessionId);
      allow create, update: if isSafeDocId(sessionId) && isValidLiveQuizSessionData(request.resource.data);
      allow delete: if isSafeDocId(sessionId);

      match /participants/{playerId} {
        allow list: if isSafeDocId(sessionId);
        allow get: if isSafeDocId(sessionId) && isSafeDocId(playerId);
        allow create, update: if isSafeDocId(sessionId) && isSafeDocId(playerId) && isValidLiveQuizParticipantData(request.resource.data);
        allow delete: if isSafeDocId(sessionId) && isSafeDocId(playerId);
      }
    }
  }
}
